[Unit]
Description=ts-exitbench Linux agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ts-exitbench
ExecStart=/usr/bin/python3 -m ts_exitbench agent --config /etc/ts-exitbench/config.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
